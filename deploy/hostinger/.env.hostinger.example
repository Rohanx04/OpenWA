# =============================================================================
# OpenWA - Hostinger VPS production environment (openwa.tachyel.com)
# =============================================================================
# Copy this file to the repository root as `.env` on the VPS:
#
#   cp deploy/hostinger/.env.hostinger.example .env
#
# scripts/deploy-hostinger.sh does this automatically and fills in the two
# generated secrets (API_MASTER_KEY, API_KEY_PEPPER) on first run.
# See docs/28-hostinger-deployment.md for the full walkthrough.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Host-side port the API container binds on 127.0.0.1 (local debugging only —
# public traffic enters through Caddy on 80/443).
API_PORT=2785

# ── Public domain ────────────────────────────────────────────────────────────
# Served by the Caddy reverse proxy (deploy/hostinger/Caddyfile) with automatic
# Let's Encrypt TLS. DNS for this hostname MUST point at the VPS IP first.
DOMAIN=openwa.tachyel.com
OPENWA_DOMAIN=openwa.tachyel.com
BASE_URL=https://openwa.tachyel.com
DASHBOARD_URL=https://openwa.tachyel.com

# E-mail Let's Encrypt uses for certificate-expiry notices.
ACME_EMAIL=admin@tachyel.com

# Production refuses the "*" wildcard — list explicit origins. The dashboard is
# served same-origin from the API, so its own origin is all that's needed here;
# add more origins (comma-separated) if a separate frontend will call the API.
CORS_ORIGINS=https://openwa.tachyel.com

# ── Security ─────────────────────────────────────────────────────────────────
# Master API key (X-Api-Key header) for the API and the first dashboard login.
# REQUIRED in production and must not be a known placeholder — the app refuses
# to boot otherwise. scripts/deploy-hostinger.sh generates a strong value here.
API_MASTER_KEY=

# HMAC pepper for stored API-key hashes (recommended; without it the app logs a
# startup warning and uses plain SHA-256). Also generated by the deploy script.
# NOTE: changing it later invalidates previously issued API keys.
API_KEY_PEPPER=

# Caddy connects over the compose network, so client IPs arrive in
# X-Forwarded-For. Only needed if you use per-API-key IP whitelisting
# (allowedIps): set it to the docker network range so the header is trusted.
# TRUSTED_PROXIES=172.16.0.0/12

# ── Sessions ─────────────────────────────────────────────────────────────────
# Re-attach authenticated WhatsApp sessions automatically after a restart or
# crash. Recommended `true` for a single-instance VPS deployment.
AUTO_START_SESSIONS=true
MAX_CONCURRENT_SESSIONS=0

# ── Container resources ──────────────────────────────────────────────────────
# whatsapp-web.js runs a full Chromium per session (~350-500 MB each). 2g suits
# a 4 GB VPS with 1-3 sessions; raise to 4g+ on an 8 GB plan / more sessions.
OPENWA_MEM_LIMIT=2g
OPENWA_PIDS_LIMIT=2048

# ── Database / storage / cache ───────────────────────────────────────────────
# Left unset on purpose: OpenWA defaults to zero-config SQLite + local media
# storage (persisted in the openwa_openwa-data volume), and the dashboard's
# Infrastructure page can switch to Postgres/Redis/MinIO later. To pin Postgres
# from the environment instead, set DATABASE_TYPE/HOST/PORT/USERNAME/PASSWORD
# here and start compose with `--profile postgres`.
#DATABASE_TYPE=postgres
#DATABASE_HOST=postgres
#DATABASE_PORT=5432
#DATABASE_NAME=openwa
#DATABASE_USERNAME=openwa
#DATABASE_PASSWORD=

# ── Webhooks / rate limiting (sane production defaults) ──────────────────────
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
